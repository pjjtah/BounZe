  m_Script: {fileID: 11500000, guid: 86fbc46bb3b71ad4ca146d9a3388f880, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  flavourTexts:
  - HAVE A NICE DAY
  - Check out our other game, CrocoDale!
  - Enjoying BounZe? Please rate it on Google Play :)
  - Take it easy, it's just a game
  - Take a deep breath
  - Relax
  - Love is always wise
  - Hammocks are great!
  - Be yourself
  - Believe in yourself
  - Sharing is caring
  - Your next chapter is going to be amazing
  - Take a break from whatever you're doing
  - Thank you for playing my game!
  - There's no need to know what you're doing
  - Listen to your favourite song
  - You're breathtaking
  - There's no wasted time
  text: {fileID: 606589672}
